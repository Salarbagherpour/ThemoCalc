import numpy as np
import pandas as pd
import time
from tc_python import *

# =========================
# Read input file
# =========================

df_inp = pd.read_csv('./6000.csv')
print("Input columns:")
print(list(df_inp.columns.values))

inputs_list = ['Si', 'Fe', 'Cu', 'Mn', 'Mg', 'Cr']

input_frame = df_inp[inputs_list]
input_frame_nonan = input_frame.dropna(axis=0)
input_values = input_frame_nonan.values

# Al balance
al_content = 100 - np.sum(input_values, axis=1)
al_content = np.reshape(al_content, (len(al_content), -1))

all_chemistries = np.concatenate((al_content, input_values), axis=1)

all_inputs_list = ['Al', 'Si', 'Fe', 'Cu', 'Mn', 'Mg', 'Cr']

df_combined_chemistries = pd.DataFrame(
    all_chemistries,
    columns=all_inputs_list
)

# =========================
# TC-Python settings
# =========================

base = 'Al'
elem = ['Si', 'Fe', 'Cu', 'Mn', 'Mg', 'Cr']

database = "TCAL10"

# Use higher temperature, especially for high-Cr alloys
t_start = 1400       # K
t_step = 1.0         # K
min_liq = 0.005      # stop at 0.5% liquid

start_api_server()


# =========================
# Helper functions
# =========================

def get_unique_phases(rlist):
    uni_phases = []

    for mixture in rlist.keys():
        phases = mixture.split(' + ')

        for ph in phases:
            if ph not in ['LIQUID'] + uni_phases:
                uni_phases.append(ph)

    return uni_phases


def print_available_scheil_quantities():
    print("\nAvailable ScheilQuantity functions containing 'fraction', 'component', or 'phase':")

    for name in dir(ScheilQuantity):
        lname = name.lower()
        if "fraction" in lname or "component" in lname or "phase" in lname:
            print(name)


def extract_final_value(data):
    """
    Expects TC-Python result as two arrays:
    value array and temperature array.
    Returns value at lowest temperature.
    """

    data = np.asarray(data)

    values = data[0, :]
    temps = data[1, :]

    idx = np.argmin(temps)

    return values[idx]


def get_cr_wt_percent_in_phase(result, phase_name):
    """
    Returns Cr wt% in a given solid phase at the final Scheil temperature.

    The function tries several possible TC-Python syntax versions.
    """

    possible_element_names = ["Cr", "CR"]

    possible_quantity_names = [
        "mass_fraction_of_component_in_phase",
        "mass_fraction_of_component_in_a_phase",
        "mass_fraction_of_component_in_solid_phase",
        "mass_fraction_of_component_in_a_solid_phase",
        "mass_fraction_of_a_component_in_phase",
        "mass_fraction_of_a_component_in_a_phase",
        "mass_fraction_of_a_component_in_solid_phase",
        "mass_fraction_of_a_component_in_a_solid_phase",
        "weight_fraction_of_component_in_phase",
        "weight_fraction_of_component_in_a_phase",
        "weight_fraction_of_component_in_solid_phase",
        "weight_fraction_of_component_in_a_solid_phase"
    ]

    for qname in possible_quantity_names:

        if not hasattr(ScheilQuantity, qname):
            continue

        qfunc = getattr(ScheilQuantity, qname)

        for el in possible_element_names:

            # Try order: element, phase
            try:
                cr_data = result.get_values_of(
                    qfunc(el, phase_name),
                    ScheilQuantity.temperature()
                )

                cr_fraction = extract_final_value(cr_data)

                # Usually TC-Python returns mass fraction, so convert to wt%
                return cr_fraction * 100.0

            except Exception:
                pass

            # Try order: phase, element
            try:
                cr_data = result.get_values_of(
                    qfunc(phase_name, el),
                    ScheilQuantity.temperature()
                )

                cr_fraction = extract_final_value(cr_data)

                return cr_fraction * 100.0

            except Exception:
                pass

    print(f"\nWARNING: Could not extract Cr content for phase: {phase_name}")
    return np.nan


# =========================
# Thermo-Calc setup
# =========================

system = (
    SetUp()
    .select_database_and_elements(database, [base] + elem)
    .get_system()
)

calculator = (
    system
    .with_scheil_calculation()
    .with_options(ScheilOptions().set_temperature_step(t_step))
    .with_options(ScheilOptions().terminate_on_fraction_of_liquid_phase(min_liq))
    .enable_global_minimization()
    .set_start_temperature(t_start)
    .set_composition_unit(CompositionUnit.MASS_PERCENT)
)

# =========================
# Output dataframe
# =========================

df_ph = df_combined_chemistries[elem].copy()

all_phases = []
failed_alloys = []

start_time = time.time()


# =========================
# Main calculation
# =========================

def phase_obtain(row_entire):

    index = row_entire[0]
    row = row_entire[1]

    print("\n======================================")
    print(f"Running alloy index: {index}")
    print("Composition:")
    print(row)
    print("======================================")

    for el in elem:
        calculator.set_composition(el, row[el])

    try:
        result = calculator.calculate()

    except Exception as e:
        print(f"\nERROR: Scheil calculation failed for alloy index {index}")
        print(e)
        failed_alloys.append(index)
        return

    try:
        rlist = result.get_values_grouped_by_stable_phases_of(
            ScheilQuantity.temperature(),
            ScheilQuantity.volume_fraction_of_all_solid_phases()
        )

        phases = get_unique_phases(rlist)

    except Exception as e:
        print(f"\nERROR: Could not get phase list for alloy index {index}")
        print(e)
        failed_alloys.append(index)
        return

    print("Phases found:")
    print(phases)

    for ph in phases:

        phase_col = ph
        cr_col = f"{ph}_Cr_wt%"

        if phase_col not in df_ph.columns:
            df_ph[phase_col] = 0.0

        if cr_col not in df_ph.columns:
            df_ph[cr_col] = np.nan

        try:
            phasefrac = result.get_values_of(
                ScheilQuantity.volume_fraction_of_a_solid_phase(ph),
                ScheilQuantity.temperature()
            )

            phase_volume_fraction = extract_final_value(phasefrac)

        except Exception as e:
            print(f"Could not extract volume fraction for phase {ph}")
            print(e)
            phase_volume_fraction = np.nan

        cr_wt_percent = get_cr_wt_percent_in_phase(result, ph)

        df_ph.loc[index, phase_col] = phase_volume_fraction
        df_ph.loc[index, cr_col] = cr_wt_percent

        print(
            f"Phase: {ph} | "
            f"Volume fraction: {phase_volume_fraction} | "
            f"Cr wt%: {cr_wt_percent}"
        )

        if ph not in all_phases:
            all_phases.append(ph)


# =========================
# Run calculations
# =========================

for row_entire in df_combined_chemistries.iterrows():
    phase_obtain(row_entire)


# =========================
# Reorder columns
# =========================

ordered_cols = elem.copy()

for ph in all_phases:
    ordered_cols.append(ph)
    ordered_cols.append(f"{ph}_Cr_wt%")

df_ph = df_ph[ordered_cols]


# =========================
# Save output
# =========================

output_file = 'PhaseFractions_and_CrContent_Scheil_6000.csv'
df_ph.to_csv(output_file, index=False)

end_time = time.time()

print("\nCalculation finished.")
print("Calculation time:", end_time - start_time, "seconds")
print("Output file:", output_file)

if len(failed_alloys) > 0:
    print("\nFailed alloy indices:")
    print(failed_alloys)

# Print available quantity names if Cr columns are still empty
cr_columns = [col for col in df_ph.columns if "_Cr_wt%" in col]

if len(cr_columns) > 0:
    all_cr_empty = df_ph[cr_columns].isna().all().all()

    if all_cr_empty:
        print("\nAll Cr columns are empty.")
        print("This means your TC-Python version uses a different quantity name.")
        print_available_scheil_quantities()

stop_api_server()
