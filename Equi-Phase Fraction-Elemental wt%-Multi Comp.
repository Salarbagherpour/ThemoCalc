"""
Calculate equilibrium phase volume fractions with Thermo-Calc/TC-Python.

Input:
    6000.csv with composition columns in wt%:
    Cu, Fe, Mg, Mn, Si, Cr

Output:
    phase_volume_fraction_equilibrium_600_350_100C.xlsx

Run from PyCharm after selecting the Python interpreter where TC-Python,
pandas, numpy, and openpyxl are installed.
"""

from datetime import datetime
from pathlib import Path

import pandas as pd
from tc_python import *


# ==================================================
# SETTINGS
# ==================================================

DATABASE = "TCAL10"
ELEMENTS = ["AL", "SI", "FE", "CU", "MN", "MG", "CR"]
REPORT_ELEMENTS = ["AL", "SI", "FE", "CU", "MN", "MG", "CR"]

INPUT_FILE = Path("6000.csv")
OUTPUT_FILE = Path("phase_volume_fraction_equilibrium_600_350_100C.xlsx")

TEMPERATURES_C = [600.0, 350.0, 100.0]
RAMP_STEP_CANDIDATES = [50.0, 25.0, 10.0]
EXCLUDED_PHASES = {"GAS", "IONIC_LIQ"}

# These columns are read as wt% and converted to mass fraction.
# Al is the balance element and is not set explicitly.
CHEM_COLS = ["Cu", "Fe", "Mg", "Mn", "Si", "Cr"]


# ==================================================
# HELPERS
# ==================================================

def canonical_column_map(df):
    """Map lowercase CSV headers to their original names."""
    return {str(col).strip().lower(): col for col in df.columns}


def require_columns(df, required_cols):
    column_map = canonical_column_map(df)
    missing_cols = [
        col for col in required_cols
        if col.lower() not in column_map
    ]

    if missing_cols:
        raise ValueError(
            "Missing required input columns: "
            + ", ".join(missing_cols)
            + ". Expected columns are: "
            + ", ".join(required_cols)
        )

    return {col: column_map[col.lower()] for col in required_cols}


def build_composition_from_row(row, chemistry_columns):
    return {
        "CU": float(row[chemistry_columns["Cu"]]) / 100.0,
        "FE": float(row[chemistry_columns["Fe"]]) / 100.0,
        "MG": float(row[chemistry_columns["Mg"]]) / 100.0,
        "MN": float(row[chemistry_columns["Mn"]]) / 100.0,
        "SI": float(row[chemistry_columns["Si"]]) / 100.0,
        "CR": float(row[chemistry_columns["Cr"]]) / 100.0,
    }


def set_equilibrium_conditions(calculator, temperature_c, composition):
    calculator.set_condition("T", temperature_c + 273.15)
    calculator.set_condition("P", 101325.0)
    calculator.set_condition("N", 1.0)

    for element, mass_fraction in composition.items():
        calculator.set_condition(
            ThermodynamicQuantity.mass_fraction_of_a_component(element),
            mass_fraction,
        )

    return calculator


def apply_robust_equilibrium_options(calculator):
    """
    Use more forgiving equilibrium settings when available.
    TC-Python names vary between versions, so every option is optional.
    """
    try:
        calculator.enable_global_minimization()
    except Exception:
        pass

    try:
        options = SingleEquilibriumOptions()

        for method_name, value in [
            ("set_max_no_of_iterations", 2000),
            ("set_required_accuracy", 1e-5),
            ("set_global_minimization_max_grid_points", 4000),
        ]:
            if hasattr(options, method_name):
                options = getattr(options, method_name)(value)

        if hasattr(options, "disable_approximate_driving_force_for_metastable_phases"):
            options = options.disable_approximate_driving_force_for_metastable_phases()

        calculator = calculator.with_options(options)

    except Exception:
        pass

    return calculator


def calculate_equilibrium(system, temperature_c, composition, calculator=None):
    """
    Calculate one equilibrium. Reusing the calculator lets Thermo-Calc use the
    previous higher-temperature result as a better starting point for 100 C.
    """
    if calculator is None:
        calculator = system.with_single_equilibrium_calculation()
        calculator = apply_robust_equilibrium_options(calculator)

    calculator = set_equilibrium_conditions(
        calculator,
        temperature_c,
        composition,
    )

    try:
        return calculator, calculator.calculate()
    except Exception:
        retry_calculator = system.with_single_equilibrium_calculation()
        retry_calculator = apply_robust_equilibrium_options(retry_calculator)
        retry_calculator = set_equilibrium_conditions(
            retry_calculator,
            temperature_c,
            composition,
        )
        return retry_calculator, retry_calculator.calculate_with_state()


def make_temperature_ramp(previous_temperature_c, target_temperature_c, step_c):
    if previous_temperature_c is None:
        return [target_temperature_c]

    if previous_temperature_c == target_temperature_c:
        return [target_temperature_c]

    direction = -1.0 if target_temperature_c < previous_temperature_c else 1.0
    step_c = abs(step_c) * direction
    temperatures = []
    current_temperature_c = previous_temperature_c + step_c

    if direction < 0:
        while current_temperature_c > target_temperature_c:
            temperatures.append(round(current_temperature_c, 8))
            current_temperature_c += step_c
    else:
        while current_temperature_c < target_temperature_c:
            temperatures.append(round(current_temperature_c, 8))
            current_temperature_c += step_c

    temperatures.append(target_temperature_c)
    return temperatures


def calculate_requested_temperature(
    system,
    target_temperature_c,
    composition,
    previous_temperature_c=None,
    calculator=None,
):
    try:
        return calculate_equilibrium(
            system,
            target_temperature_c,
            composition,
            calculator,
        )
    except Exception as direct_error:
        last_error = direct_error

    for ramp_step_c in RAMP_STEP_CANDIDATES:
        try:
            ramp_calculator = None

            if previous_temperature_c is not None:
                ramp_calculator, _ = calculate_equilibrium(
                    system,
                    previous_temperature_c,
                    composition,
                    ramp_calculator,
                )

            ramp = make_temperature_ramp(
                previous_temperature_c,
                target_temperature_c,
                ramp_step_c,
            )

            ramp_result = None
            for ramp_temperature_c in ramp:
                if ramp_temperature_c != target_temperature_c:
                    print(
                        "  stabilizing at "
                        f"{ramp_temperature_c:g} C before "
                        f"{target_temperature_c:g} C ..."
                    )

                ramp_calculator, ramp_result = calculate_equilibrium(
                    system,
                    ramp_temperature_c,
                    composition,
                    ramp_calculator,
                )

            return ramp_calculator, ramp_result

        except Exception as ramp_error:
            last_error = ramp_error

    raise last_error


def get_present_phases(result):
    method_names = [
        "get_stable_phases",
        "get_present_phases",
        "get_phases",
        "stable_phases",
        "present_phases",
        "phases",
    ]

    for method_name in method_names:
        if not hasattr(result, method_name):
            continue

        try:
            method = getattr(result, method_name)
            value = method() if callable(method) else method
            if value is None:
                continue

            phases = sorted({
                str(phase)
                for phase in list(value)
                if str(phase) and str(phase).upper() not in EXCLUDED_PHASES
            })
            if phases:
                return phases

        except Exception:
            continue

    return []


def safe_phase_volume_fraction(result, phase_name):
    try:
        value = result.get_value_of(
            ThermodynamicQuantity.volume_fraction_of_a_phase(phase_name)
        )
        if value is None or pd.isna(value):
            return 0.0
        return max(0.0, float(value))
    except Exception:
        return 0.0


def make_thermodynamic_quantity(factory_name, *args):
    factory = getattr(ThermodynamicQuantity, factory_name, None)
    if factory is None:
        return None

    try:
        return factory(*args)
    except Exception:
        return None


def safe_element_weight_fraction_in_phase(result, phase_name, element):
    """
    Return wt% of an element inside a phase.

    Example:
        Fe wt% in AL15SI2M4, or Mg wt% in T_PHASE.

    The Console Mode string W(PHASE,ELEMENT) is used as a fallback because
    TC-Python factory method names differ between Thermo-Calc versions.
    """
    quantity_candidates = [
        make_thermodynamic_quantity(
            "mass_fraction_of_a_component_in_a_phase",
            element,
            phase_name,
        ),
        make_thermodynamic_quantity(
            "mass_fraction_of_component_in_phase",
            element,
            phase_name,
        ),
        make_thermodynamic_quantity(
            "mass_fraction_of_a_component_in_phase",
            element,
            phase_name,
        ),
        f"W({phase_name},{element})",
    ]

    for quantity in quantity_candidates:
        if quantity is None:
            continue

        try:
            value = result.get_value_of(quantity)
            if value is None or pd.isna(value):
                return 0.0
            return max(0.0, float(value) * 100.0)
        except Exception:
            continue

    return 0.0


def clean_input(input_file):
    if not input_file.exists():
        raise FileNotFoundError(
            f"Input file not found: {input_file.resolve()}"
        )

    input_df = pd.read_csv(input_file)

    if "Index" not in input_df.columns:
        input_df.insert(0, "Index", range(1, len(input_df) + 1))

    chemistry_columns = require_columns(input_df, CHEM_COLS)

    for original_col in chemistry_columns.values():
        input_df[original_col] = pd.to_numeric(
            input_df[original_col],
            errors="coerce",
        )

    bad_rows = input_df[
        input_df[list(chemistry_columns.values())].isna().any(axis=1)
    ].copy()
    valid_df = input_df.dropna(
        subset=list(chemistry_columns.values())
    ).copy()

    return valid_df, bad_rows, chemistry_columns


# ==================================================
# MAIN CALCULATION
# ==================================================

def main():
    input_df, bad_rows, chemistry_columns = clean_input(INPUT_FILE)

    print(f"Valid compositions loaded: {len(input_df)}")
    if len(bad_rows) > 0:
        print("Rows skipped because of missing/non-numeric chemistry:")
        print(bad_rows[["Index"] + list(chemistry_columns.values())])

    result_rows = []
    phase_element_rows = []
    error_rows = []
    detected_phases = set()
    sorted_temperatures_c = sorted(TEMPERATURES_C, reverse=True)

    with TCPython() as session:
        system = (
            session
            .select_database_and_elements(DATABASE, ELEMENTS)
            .get_system()
        )

        for _, input_row in input_df.iterrows():
            alloy_id = input_row["Index"]
            composition = build_composition_from_row(
                input_row,
                chemistry_columns,
            )

            sum_solutes = sum(composition.values())
            if sum_solutes >= 1.0:
                error_rows.append({
                    "Alloy_ID": alloy_id,
                    "Temperature_C": None,
                    "Error": (
                        "Sum of solute mass fractions >= 1.0 "
                        f"({sum_solutes:.6f})"
                    ),
                })
                continue

            alloy_calculator = None
            previous_temperature_c = None

            for temperature_c in sorted_temperatures_c:
                print(
                    f"Running composition {alloy_id} at "
                    f"{temperature_c:g} C ..."
                )

                try:
                    alloy_calculator, calculation_result = calculate_requested_temperature(
                        system,
                        temperature_c,
                        composition,
                        previous_temperature_c,
                        alloy_calculator,
                    )
                    previous_temperature_c = temperature_c

                    present_phases = get_present_phases(calculation_result)
                    detected_phases.update(present_phases)

                    output_row = {
                        "Alloy_ID": alloy_id,
                        "Temperature_C": temperature_c,
                    }

                    for chem_col in CHEM_COLS:
                        output_row[f"{chem_col}_wt_percent"] = float(
                            input_row[chemistry_columns[chem_col]]
                        )

                    for phase in present_phases:
                        phase_vf_percent = safe_phase_volume_fraction(
                            calculation_result,
                            phase,
                        ) * 100.0

                        output_row[phase] = phase_vf_percent

                        phase_element_row = {
                            "Alloy_ID": alloy_id,
                            "Temperature_C": temperature_c,
                            "Phase": phase,
                            "Phase_volume_fraction_percent": phase_vf_percent,
                        }

                        for chem_col in CHEM_COLS:
                            phase_element_row[f"{chem_col}_alloy_wt_percent"] = float(
                                input_row[chemistry_columns[chem_col]]
                            )

                        phase_element_row["Al_alloy_wt_percent"] = (
                            100.0
                            - sum(
                                float(input_row[chemistry_columns[chem_col]])
                                for chem_col in CHEM_COLS
                            )
                        )

                        for element in REPORT_ELEMENTS:
                            phase_element_row[
                                f"{element}_in_phase_wt_percent"
                            ] = safe_element_weight_fraction_in_phase(
                                calculation_result,
                                phase,
                                element,
                            )

                        phase_element_rows.append(phase_element_row)

                    result_rows.append(output_row)

                except Exception as exc:
                    alloy_calculator = None
                    error_rows.append({
                        "Alloy_ID": alloy_id,
                        "Temperature_C": temperature_c,
                        "Error": str(exc),
                    })

    write_output(
        result_rows,
        phase_element_rows,
        error_rows,
        bad_rows,
        detected_phases,
    )


def write_output(
    result_rows,
    phase_element_rows,
    error_rows,
    bad_rows,
    detected_phases,
):
    df_results = pd.DataFrame(result_rows)
    phase_columns = sorted(detected_phases)
    composition_columns = [f"{col}_wt_percent" for col in CHEM_COLS]

    for phase in phase_columns:
        if phase not in df_results.columns:
            df_results[phase] = 0.0

    if len(df_results) > 0 and phase_columns:
        df_results[phase_columns] = df_results[phase_columns].fillna(0.0)

    nonzero_phase_columns = [
        phase for phase in phase_columns
        if len(df_results) > 0 and (df_results[phase] > 0.0).any()
    ]

    ordered_columns = (
        ["Alloy_ID", "Temperature_C"]
        + composition_columns
        + nonzero_phase_columns
    )
    ordered_columns = [
        col for col in ordered_columns
        if col in df_results.columns
    ]

    if len(df_results) > 0:
        df_results = df_results[ordered_columns]

    df_long = make_long_results(df_results, nonzero_phase_columns)
    df_phase_elements = pd.DataFrame(phase_element_rows)
    df_errors = pd.DataFrame(error_rows)

    if len(df_phase_elements) > 0:
        phase_element_columns = (
            ["Alloy_ID", "Temperature_C", "Phase", "Phase_volume_fraction_percent"]
            + [f"{col}_alloy_wt_percent" for col in CHEM_COLS]
            + ["Al_alloy_wt_percent"]
            + [f"{element}_in_phase_wt_percent" for element in REPORT_ELEMENTS]
        )
        phase_element_columns = [
            col for col in phase_element_columns
            if col in df_phase_elements.columns
        ]
        df_phase_elements = df_phase_elements[phase_element_columns]

    output_file = OUTPUT_FILE

    try:
        write_excel_workbook(
            output_file,
            df_results,
            df_long,
            df_phase_elements,
            df_errors,
            bad_rows,
        )
    except PermissionError:
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        output_file = OUTPUT_FILE.with_name(
            f"{OUTPUT_FILE.stem}_{timestamp}{OUTPUT_FILE.suffix}"
        )
        print(
            f"Could not write {OUTPUT_FILE} because it is open or locked. "
            f"Writing {output_file} instead."
        )
        write_excel_workbook(
            output_file,
            df_results,
            df_long,
            df_phase_elements,
            df_errors,
            bad_rows,
        )

    print(f"Done. Results exported to: {output_file.resolve()}")


def write_excel_workbook(
    output_file,
    df_results,
    df_long,
    df_phase_elements,
    df_errors,
    bad_rows,
):
    with pd.ExcelWriter(output_file, engine="openpyxl") as writer:
        df_results.to_excel(
            writer,
            sheet_name="Phase_VF_wide",
            index=False,
        )
        df_long.to_excel(
            writer,
            sheet_name="Phase_VF_long",
            index=False,
        )
        df_phase_elements.to_excel(
            writer,
            sheet_name="Phase_Element_wt_percent",
            index=False,
        )
        if len(df_errors) > 0:
            df_errors.to_excel(writer, sheet_name="Errors", index=False)
        if len(bad_rows) > 0:
            bad_rows.to_excel(writer, sheet_name="Bad_Input_Rows", index=False)


def make_long_results(df_results, phase_columns):
    if len(df_results) == 0 or not phase_columns:
        return pd.DataFrame(
            columns=["Alloy_ID", "Temperature_C", "Phase", "Volume_fraction_percent"]
        )

    id_columns = [
        col for col in df_results.columns
        if col not in phase_columns
    ]

    return df_results.melt(
        id_vars=id_columns,
        value_vars=phase_columns,
        var_name="Phase",
        value_name="Volume_fraction_percent",
    )


if __name__ == "__main__":
    main()
