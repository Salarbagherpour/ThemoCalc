import numpy as np
import pandas as pd
import time
import os
from tc_python import *


# ============================================================
# User settings
# ============================================================

input_file = r"./6000.csv"
output_file = "Fast_Equilibrium_GM_AL15SI2M4_6000.csv"

database = "TCAL10"

base = "Al"
elem = ["Si", "Fe", "Cu", "Mn", "Mg", "Cr"]
all_inputs_list = [base] + elem

target_phase = "AL15SI2M4"

# Temperature range
t_high_C = 700.0
t_low_C = 100.0

# Fast search settings
coarse_step_C = 50.0      # first scan step
fine_step_C = 10.0        # final output step
extra_window_C = 50.0     # add extra range above/below detected region

# Stop control
stop_after_absent_points = 6
max_alloys = None         # use None for all alloys, or set e.g. 5 for testing

pressure = 101325.0       # Pa

# Global minimization is accurate but slower.
# Start with False for speed. If results look wrong, change to True.
use_global_minimization = False


# ============================================================
# Helper functions
# ============================================================

def c_to_k(t_c):
    return t_c + 273.15


def check_input_file(path):
    print("Current working directory:")
    print(os.getcwd())

    print("\nLooking for input file:")
    print(os.path.abspath(path))

    if not os.path.exists(path):
        raise FileNotFoundError(
            f"\nInput file was not found:\n{os.path.abspath(path)}\n\n"
            f"Put 6000.csv in this folder or use the full file path."
        )


def make_temperature_list(t_high, t_low, step):
    """
    Creates finite temperature list from high to low.
    Prevents accidental endless or extremely long loops.
    """
    if step <= 0:
        raise ValueError("Temperature step must be positive.")

    if t_high < t_low:
        raise ValueError("t_high_C must be larger than t_low_C.")

    n_steps = int(np.floor((t_high - t_low) / step)) + 1
    temps = [t_high - i * step for i in range(n_steps)]

    # Make sure lower limit is included if needed
    if temps[-1] > t_low:
        temps.append(t_low)

    return np.array(temps, dtype=float)


def safe_get_value(result, possible_quantities):
    """
    Try different Thermo-Calc console quantities.
    Returns np.nan if all fail.
    """
    for q in possible_quantities:
        try:
            return float(result.get_value_of(q))
        except Exception:
            pass

    return np.nan


def get_phase_amount(result, phase_name):
    """
    Try to get phase amount for equilibrium calculation.

    NP(PHASE) is often phase mole amount/fraction type.
    BP(PHASE) or BS(PHASE) may work depending on TC version/result type.
    """
    return safe_get_value(
        result,
        [
            f"NP({phase_name})",
            f"BP({phase_name})",
            f"BS({phase_name})",
            f"NP({phase_name}#1)",
            f"BP({phase_name}#1)",
            f"BS({phase_name}#1)",
        ]
    )


def get_phase_gibbs_energy(result, phase_name):
    """
    Molar Gibbs energy of the phase.
    Usually GM(PHASE), unit usually J/mol.
    """
    return safe_get_value(
        result,
        [
            f"GM({phase_name})",
            f"GM({phase_name}#1)",
            f"G({phase_name})",
            f"G({phase_name}#1)",
        ]
    )


def calculate_one_equilibrium(calculator, row, temperature_C):
    """
    Run one equilibrium calculation at one temperature and one composition.
    """

    temperature_K = c_to_k(temperature_C)

    calculator.set_condition(
        ThermodynamicQuantity.temperature(),
        temperature_K
    )

    calculator.set_condition(
        ThermodynamicQuantity.pressure(),
        pressure
    )

    # Set N-1 composition conditions.
    # Base Al is automatically balance.
    for el in elem:
        calculator.set_condition(
            ThermodynamicQuantity.mass_fraction_of_a_component(el),
            row[el] / 100.0
        )

    result = calculator.calculate()

    phase_amount = get_phase_amount(result, target_phase)
    phase_present = False

    if not pd.isna(phase_amount) and phase_amount > 1e-12:
        phase_present = True

    if phase_present:
        gm = get_phase_gibbs_energy(result, target_phase)
    else:
        gm = np.nan

    return {
        "T_C": temperature_C,
        "T_K": temperature_K,
        f"{target_phase}_phase_amount": phase_amount,
        f"{target_phase}_present": phase_present,
        f"{target_phase}_GM_J_per_mol": gm
    }


def make_calculator(system):
    calc = system.with_single_equilibrium_calculation()

    if use_global_minimization:
        calc = calc.enable_global_minimization()

    return calc


# ============================================================
# Read input file
# ============================================================

check_input_file(input_file)

df_inp = pd.read_csv(input_file)

print("\nInput columns:")
print(list(df_inp.columns.values))

missing_cols = [col for col in elem if col not in df_inp.columns]
if missing_cols:
    raise ValueError(f"Missing required input columns: {missing_cols}")

input_frame = df_inp[elem]
input_frame_nonan = input_frame.dropna(axis=0).copy()

if max_alloys is not None:
    input_frame_nonan = input_frame_nonan.iloc[:max_alloys].copy()

input_values = input_frame_nonan.values.astype(float)

solute_sum = np.sum(input_values, axis=1)
if np.any(solute_sum > 100.0):
    bad_rows = input_frame_nonan.index[solute_sum > 100.0].tolist()
    raise ValueError(
        f"Some rows have solute sum greater than 100 wt%. Bad rows: {bad_rows}"
    )

al_content = 100.0 - solute_sum
al_content = np.reshape(al_content, (len(al_content), -1))

all_chemistries = np.concatenate((al_content, input_values), axis=1)

df_combined_chemistries = pd.DataFrame(
    all_chemistries,
    columns=all_inputs_list,
    index=input_frame_nonan.index
)

print("\nPrepared compositions:")
print(df_combined_chemistries.head())


# ============================================================
# Temperature lists
# ============================================================

coarse_temps_C = make_temperature_list(
    t_high_C,
    t_low_C,
    coarse_step_C
)

print("\nCoarse temperature list:")
print(coarse_temps_C)


# ============================================================
# Run Thermo-Calc
# ============================================================

all_output_rows = []
failed_cases = []

start_time = time.time()

start_api_server()

try:
    system = (
        SetUp()
        .select_database_and_elements(database, all_inputs_list)
        .get_system()
    )

    for index, row in df_combined_chemistries.iterrows():

        print("\n==============================")
        print(f"Running alloy index: {index}")
        print(row)
        print("==============================")

        calculator = make_calculator(system)

        # ====================================================
        # Step 1: coarse scan to find AL15SI2M4 region
        # ====================================================

        coarse_results = []

        print("\nStarting coarse scan...")

        for T_C in coarse_temps_C:

            try:
                r = calculate_one_equilibrium(
                    calculator=calculator,
                    row=row,
                    temperature_C=T_C
                )

                coarse_results.append(r)

                print(
                    f"Coarse T = {T_C:.1f} C, "
                    f"present = {r[f'{target_phase}_present']}, "
                    f"amount = {r[f'{target_phase}_phase_amount']}"
                )

            except Exception as e:
                print(f"Coarse scan failed at alloy {index}, T = {T_C} C")
                print(e)

                failed_cases.append({
                    "Input_index": index,
                    "T_C": T_C,
                    "Stage": "coarse",
                    "Error": str(e)
                })

        df_coarse = pd.DataFrame(coarse_results)

        if df_coarse.empty:
            print(f"No coarse results for alloy {index}. Skipping this alloy.")
            continue

        present_rows = df_coarse[
            df_coarse[f"{target_phase}_present"] == True
        ]

        # If AL15SI2M4 is never present, save coarse info and skip fine scan.
        if present_rows.empty:
            print(
                f"{target_phase} was not present in coarse scan "
                f"for alloy index {index}. Skipping fine scan."
            )

            for _, rr in df_coarse.iterrows():
                output_row = {
                    "Input_index": index,
                    "Scan_type": "coarse_only_no_phase",
                    "Target_phase": target_phase,
                    "Al_wt_percent": row["Al"],
                    "Si_wt_percent": row["Si"],
                    "Fe_wt_percent": row["Fe"],
                    "Cu_wt_percent": row["Cu"],
                    "Mn_wt_percent": row["Mn"],
                    "Mg_wt_percent": row["Mg"],
                    "Cr_wt_percent": row["Cr"],
                }

                output_row.update(rr.to_dict())
                all_output_rows.append(output_row)

            pd.DataFrame(all_output_rows).to_csv(output_file, index=False)
            continue

        # ====================================================
        # Step 2: define smaller fine scan window
        # ====================================================

        phase_t_high = present_rows["T_C"].max()
        phase_t_low = present_rows["T_C"].min()

        fine_high = min(t_high_C, phase_t_high + extra_window_C)
        fine_low = max(t_low_C, phase_t_low - extra_window_C)

        fine_temps_C = make_temperature_list(
            fine_high,
            fine_low,
            fine_step_C
        )

        print("\nDetected phase region from coarse scan:")
        print(f"{phase_t_high:.1f} C down to {phase_t_low:.1f} C")

        print("\nFine scan window:")
        print(f"{fine_high:.1f} C down to {fine_low:.1f} C")

        print("\nFine temperature list:")
        print(fine_temps_C)

        # ====================================================
        # Step 3: fine scan only near AL15SI2M4 region
        # ====================================================

        absent_after_found = 0
        found_once = False

        print("\nStarting fine scan...")

        for T_C in fine_temps_C:

            try:
                r = calculate_one_equilibrium(
                    calculator=calculator,
                    row=row,
                    temperature_C=T_C
                )

                phase_present = r[f"{target_phase}_present"]

                if phase_present:
                    found_once = True
                    absent_after_found = 0
                else:
                    if found_once:
                        absent_after_found += 1

                output_row = {
                    "Input_index": index,
                    "Scan_type": "fine",
                    "Target_phase": target_phase,
                    "Al_wt_percent": row["Al"],
                    "Si_wt_percent": row["Si"],
                    "Fe_wt_percent": row["Fe"],
                    "Cu_wt_percent": row["Cu"],
                    "Mn_wt_percent": row["Mn"],
                    "Mg_wt_percent": row["Mg"],
                    "Cr_wt_percent": row["Cr"],
                }

                output_row.update(r)
                all_output_rows.append(output_row)

                print(
                    f"Fine T = {T_C:.1f} C, "
                    f"present = {phase_present}, "
                    f"amount = {r[f'{target_phase}_phase_amount']}, "
                    f"GM = {r[f'{target_phase}_GM_J_per_mol']}"
                )

                # Stop early after phase disappears
                if absent_after_found >= stop_after_absent_points:
                    print(
                        f"Stopping fine scan for alloy {index}: "
                        f"{target_phase} disappeared for "
                        f"{stop_after_absent_points} consecutive points."
                    )
                    break

            except Exception as e:
                print(f"Fine scan failed at alloy {index}, T = {T_C} C")
                print(e)

                failed_cases.append({
                    "Input_index": index,
                    "T_C": T_C,
                    "Stage": "fine",
                    "Error": str(e)
                })

        # Save after each alloy
        pd.DataFrame(all_output_rows).to_csv(output_file, index=False)
        print(f"Saved partial output after alloy {index}")

finally:
    stop_api_server()


# ============================================================
# Save final output
# ============================================================

df_out = pd.DataFrame(all_output_rows)

if not df_out.empty:
    df_out = df_out.sort_values(
        by=["Input_index", "T_C"],
        ascending=[True, False]
    )

    df_out.to_csv(output_file, index=False)

end_time = time.time()

print("\nCalculation finished.")
print("Calculation time:", end_time - start_time, "seconds")
print("Output file:", output_file)

if failed_cases:
    failed_file = "Failed_cases_Equilibrium_GM_AL15SI2M4.csv"
    pd.DataFrame(failed_cases).to_csv(failed_file, index=False)
    print("Failed cases file:", failed_file)
