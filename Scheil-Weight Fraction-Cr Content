import numpy as np
import pandas as pd
import time
from tc_python import *


# =========================
# User settings
# =========================

input_file = "./6000.csv"
output_file = "PhaseWtPercent_CrDistribution_Scheil_6000.csv"

database = "TCAL10"

base = "Al"
elem = ["Si", "Fe", "Cu", "Mn", "Mg", "Cr"]
all_inputs_list = [base] + elem

t_start = 1600      # K
t_step = 1.0        # K
min_liq = 0.005     # 0.005 = stop at 0.5 wt% liquid


# =========================
# Helper functions
# =========================

def extract_final_value(data):
    values, temps = data
    values = np.asarray(values)
    temps = np.asarray(temps)

    idx = np.argmin(temps)
    return float(values[idx])


def get_unique_solid_phases(grouped_result):
    unique_phases = []

    for mixture in grouped_result.keys():
        phases = mixture.split(" + ")

        for ph in phases:
            if ph != "LIQUID" and ph not in unique_phases:
                unique_phases.append(ph)

    return unique_phases


def get_scheil_value(result, quantity, console_quantity=None):
    """
    Gets final value at lowest temperature.
    If the ScheilQuantity form fails, tries Console Mode syntax such as:
        NN(PHASE,Cr)
        BL
    """
    try:
        data = result.get_values_of(
            quantity,
            ScheilQuantity.temperature()
        )
        return extract_final_value(data)

    except Exception as first_error:
        if console_quantity is None:
            raise first_error

        data = result.get_values_of(
            console_quantity,
            ScheilQuantity.temperature()
        )
        return extract_final_value(data)


def get_solid_phase_wt_percent(result, phase_name):
    """
    Returns phase amount in wt% of the whole alloy.
    """
    try:
        phase_wf = get_scheil_value(
            result,
            ScheilQuantity.mass_fraction_of_a_solid_phase(phase_name),
            f"BS({phase_name})"
        )
        return phase_wf * 100.0

    except Exception as e:
        print(f"Could not get phase wt% for {phase_name}: {e}")
        return np.nan


def get_liquid_wt_percent(result, solid_phase_wt_percents):
    """
    Returns liquid amount in wt% of the whole alloy.
    Prefer direct Thermo-Calc liquid fraction.
    If unavailable, estimate from:
        liquid = 100 - sum(solid phases)
    """
    try:
        liquid_wf = get_scheil_value(
            result,
            ScheilQuantity.mass_fraction_of_liquid_phase(),
            "BL"
        )
        return liquid_wf * 100.0

    except Exception:
        solid_sum = np.nansum(solid_phase_wt_percents)
        return max(0.0, 100.0 - solid_sum)


def get_cr_distribution_fraction(result, phase_name):
    """
    Returns the fraction of total Cr inventory located in this phase.

    Example:
        0.30 means 30% of all Cr in the alloy is in this phase.

    This is better for mass balance than using only final W(phase,Cr).
    """
    try:
        cr_dist = get_scheil_value(
            result,
            ScheilQuantity.distribution_of_component_of_phase(
                phase_name,
                "Cr"
            ),
            f"NN({phase_name},Cr)"
        )
        return cr_dist

    except Exception as e:
        print(f"Could not get Cr distribution for {phase_name}: {e}")
        return np.nan


def calculate_average_cr_wt_percent_in_phase(
    input_cr_wt_percent,
    phase_wt_percent,
    cr_distribution_fraction
):
    """
    Cr in phase, averaged over the total amount of that phase:

        Cr_from_phase = input_Cr * Cr_distribution
        average_Cr_in_phase = 100 * Cr_from_phase / phase_wt_percent

    All wt% units.
    """
    if (
        pd.isna(phase_wt_percent)
        or pd.isna(cr_distribution_fraction)
        or phase_wt_percent <= 0.0
    ):
        return np.nan

    cr_from_phase_wt_percent = input_cr_wt_percent * cr_distribution_fraction
    return 100.0 * cr_from_phase_wt_percent / phase_wt_percent


# =========================
# Read input file
# =========================

df_inp = pd.read_csv(input_file)

print("Input columns:")
print(list(df_inp.columns.values))

missing_cols = [col for col in elem if col not in df_inp.columns]
if missing_cols:
    raise ValueError(f"Missing required input columns: {missing_cols}")

input_frame = df_inp[elem]
input_frame_nonan = input_frame.dropna(axis=0).copy()

input_values = input_frame_nonan.values.astype(float)

solute_sum = np.sum(input_values, axis=1)
if np.any(solute_sum > 100.0):
    bad_rows = input_frame_nonan.index[solute_sum > 100.0].tolist()
    raise ValueError(
        f"Some rows have solute sum greater than 100 wt%. Bad rows: {bad_rows}"
    )

al_content = 100.0 - solute_sum
al_content = np.reshape(al_content, (len(al_content), -1))

all_chemistries = np.concatenate((al_content, input_values), axis=1)

df_combined_chemistries = pd.DataFrame(
    all_chemistries,
    columns=all_inputs_list,
    index=input_frame_nonan.index
)

print("\nPrepared compositions:")
print(df_combined_chemistries.head())


# =========================
# Output dataframe
# =========================

df_ph = df_combined_chemistries[elem].copy()

all_solid_phases = []
failed_alloys = []

start_time = time.time()


# =========================
# Run Thermo-Calc
# =========================

start_api_server()

try:
    system = (
        SetUp()
        .select_database_and_elements(database, all_inputs_list)
        .get_system()
    )

    calculator = (
        system
        .with_scheil_calculation()
        .with_options(ScheilOptions().set_temperature_step(t_step))
        .with_options(ScheilOptions().terminate_on_fraction_of_liquid_phase(min_liq))
        .enable_global_minimization()
        .set_start_temperature(t_start)
        .set_composition_unit(CompositionUnit.MASS_PERCENT)
    )

    for index, row in df_combined_chemistries.iterrows():

        print("\n==============================")
        print(f"Running alloy index: {index}")
        print(row)
        print("==============================")

        for el in elem:
            calculator.set_composition(el, row[el])

        try:
            result = calculator.calculate()

        except Exception as e:
            print(f"ERROR: Scheil calculation failed for alloy index {index}")
            print(e)
            failed_alloys.append(index)
            continue

        try:
            grouped = result.get_values_grouped_by_stable_phases_of(
                ScheilQuantity.temperature(),
                ScheilQuantity.mass_fraction_of_all_solid_phases()
            )

            solid_phases = get_unique_solid_phases(grouped)

        except Exception as e:
            print(f"ERROR: Could not get phases for alloy index {index}")
            print(e)
            failed_alloys.append(index)
            continue

        print("Solid phases found:", solid_phases)

        input_cr_wt_percent = row["Cr"]

        solid_phase_wt_percents = []
        solid_cr_total_wt_percent = 0.0
        cr_distribution_sum = 0.0

        # =========================
        # Solid phases
        # =========================

        for ph in solid_phases:

            phase_pct_col = f"{ph}_wt_percent"
            cr_dist_col = f"{ph}_Cr_distribution_percent"
            cr_contrib_col = f"{ph}_Cr_contribution_wt_percent"
            cr_avg_col = f"{ph}_Average_Cr_wt_percent"

            if phase_pct_col not in df_ph.columns:
                df_ph[phase_pct_col] = 0.0

            if cr_dist_col not in df_ph.columns:
                df_ph[cr_dist_col] = np.nan

            if cr_contrib_col not in df_ph.columns:
                df_ph[cr_contrib_col] = np.nan

            if cr_avg_col not in df_ph.columns:
                df_ph[cr_avg_col] = np.nan

            phase_wt_percent = get_solid_phase_wt_percent(result, ph)
            cr_distribution_fraction = get_cr_distribution_fraction(result, ph)

            cr_distribution_percent = cr_distribution_fraction * 100.0
            cr_contribution_wt_percent = (
                input_cr_wt_percent * cr_distribution_fraction
            )

            average_cr_wt_percent = calculate_average_cr_wt_percent_in_phase(
                input_cr_wt_percent,
                phase_wt_percent,
                cr_distribution_fraction
            )

            df_ph.loc[index, phase_pct_col] = phase_wt_percent
            df_ph.loc[index, cr_dist_col] = cr_distribution_percent
            df_ph.loc[index, cr_contrib_col] = cr_contribution_wt_percent
            df_ph.loc[index, cr_avg_col] = average_cr_wt_percent

            solid_phase_wt_percents.append(phase_wt_percent)

            if not pd.isna(cr_contribution_wt_percent):
                solid_cr_total_wt_percent += cr_contribution_wt_percent

            if not pd.isna(cr_distribution_fraction):
                cr_distribution_sum += cr_distribution_fraction

            print(
                f"{ph}: phase wt% = {phase_wt_percent}, "
                f"Cr distribution = {cr_distribution_percent}%, "
                f"Cr contribution = {cr_contribution_wt_percent} wt%, "
                f"average Cr in phase = {average_cr_wt_percent} wt%"
            )

            if ph not in all_solid_phases:
                all_solid_phases.append(ph)

        # =========================
        # Remaining liquid
        # =========================

        liquid_wt_percent = get_liquid_wt_percent(result, solid_phase_wt_percents)
        liquid_cr_distribution_fraction = get_cr_distribution_fraction(result, "LIQUID")

        liquid_cr_distribution_percent = liquid_cr_distribution_fraction * 100.0
        liquid_cr_contribution_wt_percent = (
            input_cr_wt_percent * liquid_cr_distribution_fraction
        )

        liquid_average_cr_wt_percent = calculate_average_cr_wt_percent_in_phase(
            input_cr_wt_percent,
            liquid_wt_percent,
            liquid_cr_distribution_fraction
        )

        df_ph.loc[index, "LIQUID_wt_percent"] = liquid_wt_percent
        df_ph.loc[index, "LIQUID_Cr_distribution_percent"] = liquid_cr_distribution_percent
        df_ph.loc[index, "LIQUID_Cr_contribution_wt_percent"] = liquid_cr_contribution_wt_percent
        df_ph.loc[index, "LIQUID_Average_Cr_wt_percent"] = liquid_average_cr_wt_percent

        liquid_cr_total_wt_percent = 0.0

        if not pd.isna(liquid_cr_contribution_wt_percent):
            liquid_cr_total_wt_percent = liquid_cr_contribution_wt_percent
            cr_distribution_sum += liquid_cr_distribution_fraction

        print(
            f"LIQUID: wt% = {liquid_wt_percent}, "
            f"Cr distribution = {liquid_cr_distribution_percent}%, "
            f"Cr contribution = {liquid_cr_contribution_wt_percent} wt%, "
            f"average Cr in liquid = {liquid_average_cr_wt_percent} wt%"
        )

        # =========================
        # Cr mass balance
        # =========================

        total_cr_calc_wt_percent = (
            solid_cr_total_wt_percent + liquid_cr_total_wt_percent
        )

        df_ph.loc[index, "Input_Cr_wt_percent"] = input_cr_wt_percent
        df_ph.loc[index, "Calculated_solid_Cr_wt_percent"] = solid_cr_total_wt_percent
        df_ph.loc[index, "Calculated_liquid_Cr_wt_percent"] = liquid_cr_total_wt_percent
        df_ph.loc[index, "Calculated_total_Cr_wt_percent"] = total_cr_calc_wt_percent
        df_ph.loc[index, "Cr_balance_error_wt_percent"] = (
            total_cr_calc_wt_percent - input_cr_wt_percent
        )
        df_ph.loc[index, "Cr_distribution_sum_percent"] = cr_distribution_sum * 100.0
        df_ph.loc[index, "Cr_distribution_error_percent"] = (
            cr_distribution_sum * 100.0 - 100.0
        )

        print(f"Input Cr wt%: {input_cr_wt_percent}")
        print(f"Calculated solid Cr wt%: {solid_cr_total_wt_percent}")
        print(f"Calculated liquid Cr wt%: {liquid_cr_total_wt_percent}")
        print(f"Calculated total Cr wt%: {total_cr_calc_wt_percent}")
        print(f"Cr balance error wt%: {total_cr_calc_wt_percent - input_cr_wt_percent}")
        print(f"Cr distribution sum %: {cr_distribution_sum * 100.0}")

finally:
    stop_api_server()


# =========================
# Reorder columns
# =========================

ordered_cols = elem.copy()

for ph in all_solid_phases:
    ordered_cols.extend([
        f"{ph}_wt_percent",
        f"{ph}_Average_Cr_wt_percent",
        f"{ph}_Cr_contribution_wt_percent",
        f"{ph}_Cr_distribution_percent",
    ])

ordered_cols.extend([
    "LIQUID_wt_percent",
    "LIQUID_Average_Cr_wt_percent",
    "LIQUID_Cr_contribution_wt_percent",
    "LIQUID_Cr_distribution_percent",
    "Input_Cr_wt_percent",
    "Calculated_solid_Cr_wt_percent",
    "Calculated_liquid_Cr_wt_percent",
    "Calculated_total_Cr_wt_percent",
    "Cr_balance_error_wt_percent",
    "Cr_distribution_sum_percent",
    "Cr_distribution_error_percent",
])

ordered_cols = [col for col in ordered_cols if col in df_ph.columns]
df_ph = df_ph[ordered_cols]


# =========================
# Save output
# =========================

df_ph.to_csv(output_file, index=True, index_label="Input_index")

end_time = time.time()

print("\nCalculation finished.")
print("Calculation time:", end_time - start_time, "seconds")
print("Output file:", output_file)

if failed_alloys:
    print("Failed alloy indices:")
    print(failed_alloys)
